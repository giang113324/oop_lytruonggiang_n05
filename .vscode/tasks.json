{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile C++",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "-I",
                "${workspaceFolder}/bai_thuc_hanh_01",
                "${workspaceFolder}/bai_thuc_hanh_01/main.cpp",
                "-o",
                "${workspaceFolder}/bai_thuc_hanh_01/output/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}